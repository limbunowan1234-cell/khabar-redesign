{
  "name": "khabar-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create khabar-d1",
    "db:schema": "wrangler d1 execute khabar-d1 --file=./db/schema.sql",
    "db:schema:local": "wrangler d1 execute khabar-d1 --local --file=./db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.90.0"
  }
}
